# ============================================================================
# Environment Variables Reference
# ============================================================================
# This file documents all environment variables used in Resume-Buildr
# Copy the relevant variables to:
# - Render: artifacts/api-server/.env.render
# - Vercel: artifacts/resume-screener/.env.vercel
#
# ============================================================================

# ─── BACKEND (artifacts/api-server) ────────────────────────────────────────

# API Server Port
API_PORT=8080

# CORS allowed origins (comma-separated, no spaces)
# Production frontend: https://resume-buildr-resume-screener.vercel.app
# For local dev: http://localhost:5173
ALLOWED_ORIGINS=https://resume-buildr-resume-screener.vercel.app,http://localhost:5173

# Database URL (use Supabase PostgreSQL in production)
# Local SQLite fallback: sqlite:///resume_screening.db
# Supabase: postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Python environment
PYTHONUNBUFFERED=1

# Supabase Auth validation (backend only)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ─── FRONTEND (artifacts/resume-screener) ─────────────────────────────────

# Frontend Port (Vite dev server)
PORT=5173

# Base path for app deployment
# Use "/" for root-hosted
# Use "/app/" if deployed to subdirectory
BASE_PATH=/

# Backend API URL
# Dev: http://localhost:8080
# Prod: https://your-backend.onrender.com
VITE_API_URL=https://resume-buildr-api.onrender.com

# Supabase frontend values (publishable key only; never put the database password here)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Node environment
NODE_ENV=production

# ─── OPTIONAL / FUTURE ────────────────────────────────────────────────────

# Authentication (if adding user sessions)
# JWT_SECRET=your-secret-key-here
# AUTH_PROVIDER=github

# External services
# SENTRY_DSN=https://...
# MIXPANEL_TOKEN=...

# Feature flags
# VITE_ENABLE_ADVANCED_MATCHING=true
# VITE_ENABLE_BATCH_UPLOAD=false
